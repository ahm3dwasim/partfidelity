  "image_px": 224,
  "cmake_args": "-DGGML_NATIVE=OFF -DGGML_AVX2=ON -DGGML_FMA=ON -DGGML_F16C=ON -DGGML_CUDA=OFF",
  "runtime_deps": [
    "numpy==2.4.0",
    "typing-extensions==4.15.0",
    "diskcache==5.6.3",
    "jinja2==3.1.6",
    "markupsafe==3.0.3"
  ],
  "grade_max_tokens": 2048,
  "download_timeout_s": 120,
